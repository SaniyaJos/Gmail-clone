# Server Port
PORT=5000

# MongoDB Connection String (Replace with your own MongoDB Atlas URI or local MongoDB URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Random secret used to sign 8-hour attachment-access tokens (at least 32 characters)
JWT_SECRET=replace_with_a_random_secret_of_at_least_32_characters

# Google Gemini API Configuration for Email-to-Action Engine
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
